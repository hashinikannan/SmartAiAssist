# StudyMate AI Environment Configuration

# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Leave empty or set to localhost to use automatic fallback mode)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=studymate_db

# Firebase Configuration (Optional if local auth is enabled)
FIREBASE_CONFIG=

# Server Configuration
PORT=8000
ENVIRONMENT=development
